# Required: Anthropic API key for Claude agents
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Default Claude model for agents
KG_MODEL=claude-sonnet-4-6

# Optional: SEC EDGAR user agent (required by SEC fair access policy)
SEC_USER_AGENT=YourName your@email.com

# Optional: GitHub personal access token for GitHub provider
GITHUB_TOKEN=ghp_...

# Optional: Graph persistence directory
KG_STORE_DIR=./kg_data
